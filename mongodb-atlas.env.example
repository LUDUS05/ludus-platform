# MongoDB Atlas Configuration for LUDUS Platform
# Copy this file to .env and update with your actual values

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://ludus_app_user:YOUR_PASSWORD@ludus-production-cluster.xxxxx.mongodb.net/ludus_production?retryWrites=true&w=majority
DATABASE_NAME=ludus_production

# MongoDB Atlas Options (JSON format)
MONGODB_OPTIONS={"maxPoolSize":10,"serverSelectionTimeoutMS":5000,"socketTimeoutMS":45000,"bufferMaxEntries":0,"bufferCommands":false}

# Development Database (optional)
MONGODB_URI_DEV=mongodb+srv://ludus_app_user:YOUR_PASSWORD@ludus-production-cluster.xxxxx.mongodb.net/ludus_development?retryWrites=true&w=majority
DATABASE_NAME_DEV=ludus_development

# MongoDB Atlas Monitoring
MONGODB_MONITORING_ENABLED=true
MONGODB_SLOW_QUERY_THRESHOLD=100
MONGODB_CONNECTION_POOL_THRESHOLD=0.8

# Health Check Configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30000
HEALTH_CHECK_TIMEOUT=5000

# Application Environment
NODE_ENV=production
PORT=5000
CLIENT_URL=https://app.letsludus.com

# Database Users (for reference)
# ludus_app_user - Application user with readWrite permissions
# ludus_admin - Admin user with dbAdminAnyDatabase permissions  
# ludus_analytics - Analytics user with read permissions

# Security Notes:
# - Never commit actual passwords to version control
# - Use environment variables for all sensitive data
# - Rotate passwords regularly
# - Monitor database access logs
# - Use IP whitelisting in production
