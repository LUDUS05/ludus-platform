# ===========================================
# LUDUS Platform - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit .env files to version control

# ===========================================
# CORE APPLICATION CONFIGURATION
# ===========================================
NODE_ENV=production
PORT=5001
CLIENT_URL=https://app.letsludus.com
API_URL=https://ludus-backend.onrender.com

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Atlas Production Cluster
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/ludus_production?retryWrites=true&w=majority
MONGODB_DEV_URI=mongodb+srv://username:password@cluster.mongodb.net/ludus_development?retryWrites=true&w=majority

# ===========================================
# AUTHENTICATION & SECURITY
# ===========================================
# JWT Configuration (Generate strong secrets)
JWT_SECRET=your-super-secure-jwt-secret-key-here-min-32-chars
JWT_REFRESH_SECRET=your-super-secure-refresh-secret-key-here-min-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# ===========================================
# PAYMENT GATEWAY (MOYASAR)
# ===========================================
MOYASAR_SECRET_KEY=sk_test_your_moyasar_secret_key
MOYASAR_PUBLISHABLE_KEY=pk_test_your_moyasar_publishable_key
MOYASAR_WEBHOOK_SECRET=your_webhook_secret_for_verification
MOYASAR_SANDBOX_MODE=true

# ===========================================
# SOCIAL AUTHENTICATION
# ===========================================
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=https://ludus-backend.onrender.com/api/auth/google/callback

# Facebook OAuth (Optional)
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret
FACEBOOK_CALLBACK_URL=https://ludus-backend.onrender.com/api/auth/facebook/callback

# ===========================================
# EMAIL SERVICE CONFIGURATION
# ===========================================
# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@letsludus.com
EMAIL_FROM_NAME=LUDUS Platform

# ===========================================
# SMS SERVICE CONFIGURATION
# ===========================================
# Twilio Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ===========================================
# FILE STORAGE CONFIGURATION
# ===========================================
# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_FOLDER=ludus-production

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password
REDIS_DB=0

# ===========================================
# MONITORING & ANALYTICS
# ===========================================
# Sentry Error Tracking
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Google Analytics
GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX

# ===========================================
# EXTERNAL API KEYS
# ===========================================
# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Unsplash API (for images)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key
UNSPLASH_SECRET_KEY=your_unsplash_secret_key

# ===========================================
# RENDER.COM CONFIGURATION
# ===========================================
RENDER_ENVIRONMENT=production
RENDER_API_TOKEN=your_render_api_token
RENDER_SERVICE_ID=your_render_service_id

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# CORS Configuration
CORS_ORIGIN=https://app.letsludus.com
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# FEATURE FLAGS
# ===========================================
ANIMATION_ENABLED=true
RTL_SUPPORT=true
PERFORMANCE_MONITORING=true
DEBUG_MODE=false
MAINTENANCE_MODE=false

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FORMAT=combined
LOG_FILE=logs/app.log

# ===========================================
# BACKUP CONFIGURATION
# ===========================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=7
BACKUP_S3_BUCKET=your-backup-bucket
BACKUP_S3_REGION=us-east-1
BACKUP_S3_ACCESS_KEY=your_s3_access_key
BACKUP_S3_SECRET_KEY=your_s3_secret_key
