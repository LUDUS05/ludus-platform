# LUDUS Selena AI Service - Environment Configuration
# Copy this file to .env and configure your values

# Server Configuration
HOST=0.0.0.0
PORT=8081
DEBUG=false
ENVIRONMENT=development

# Redis Configuration (for session management)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Ollama Configuration (for AI models)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256

# Performance Configuration
MAX_CONCURRENT_REQUESTS=1000
TARGET_RESPONSE_TIME_MS=200
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS Configuration (adjust for production)
CORS_ORIGINS=http://localhost:3000,https://*.render.com

# Logging
LOG_LEVEL=INFO
ENABLE_DETAILED_LOGGING=true
ENABLE_PERFORMANCE_MONITORING=true
ENABLE_ERROR_TRACKING=true

# Session Configuration
SESSION_EXPIRE_HOURS=6
MAX_CONVERSATION_HISTORY=10

# Optional: MongoDB (if needed for persistent data)
MONGODB_URL=

# Monitoring Configuration
METRICS_RETENTION_HOURS=168
HEALTH_CHECK_INTERVAL=30