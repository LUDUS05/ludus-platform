{
  "name": "ludus-platform",
  "version": "1.0.0",
  "description": "LUDUS Social Activity Platform - Monorepo",
  "private": true,
  "packageManager": "pnpm@8.0.0",
  "scripts": {
    "dev": "pnpm run --parallel dev",
    "dev:web": "pnpm --filter @ludus/web dev",
    "dev:api": "pnpm --filter @ludus/api dev",
    "dev:ai": "pnpm --filter @ludus/ai-agents dev",
    "dev:docker": "docker-compose -f docker-compose.dev.yml up -d",
    "dev:docker:logs": "docker-compose -f docker-compose.dev.yml logs -f",
    "dev:docker:down": "docker-compose -f docker-compose.dev.yml down",
    "build": "pnpm run --recursive build",
    "build:web": "pnpm --filter @ludus/web build",
    "build:api": "pnpm --filter @ludus/api build",
    "build:ai": "pnpm --filter @ludus/ai-agents build",
    "build:packages": "pnpm --filter './packages/*' build",
    "start": "pnpm run --parallel start",
    "start:web": "pnpm --filter @ludus/web start",
    "start:api": "pnpm --filter @ludus/api start",
    "test": "pnpm run --recursive test",
    "test:web": "pnpm --filter @ludus/web test",
    "test:api": "pnpm --filter @ludus/api test",
    "test:packages": "pnpm --filter './packages/*' test",
    "lint": "pnpm run --recursive lint",
    "lint:fix": "pnpm run --recursive lint:fix",
    "type-check": "pnpm run --recursive type-check",
    "clean": "pnpm run --recursive clean && rm -rf node_modules",
    "clean:install": "pnpm run clean && pnpm install",
    "setup": "./scripts/deployment/setup-dev-environment.sh",
    "setup-demo-users": "node scripts/utility/setup-demo-users.js",
    "demo-users": "pnpm run setup-demo-users",
    "seed": "pnpm --filter @ludus/api seed",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "link:linear-notion:dry": "node scripts/utility/notion-linear-linker.js --dry-run --project LUDUS",
    "link:linear-notion": "node scripts/utility/notion-linear-linker.js --project LUDUS",
    "workspace:setup": "node scripts/utility/setup-complete-workspace.js",
    "workspace:setup:dry": "node scripts/utility/setup-complete-workspace.js --dry-run",
    "workspace:setup:force": "node scripts/utility/setup-complete-workspace.js --force",
    "workspace": "node scripts/utility/ludus-workspace-cli.js",
    "workspace:sync": "node scripts/utility/ludus-workspace-cli.js sync:all",
    "workspace:status": "node scripts/utility/ludus-workspace-cli.js status",
    "workspace:auto:daily": "node scripts/utility/daily-sync.js",
    "workspace:auto:weekly": "node scripts/utility/weekly-reports.js",
    "workspace:auto:budget": "node scripts/utility/budget-monitor.js",
    "workspace:github:track": "node scripts/utility/github-repo-tracker.js",
    "workspace:github:reviews": "node scripts/utility/github-review-dashboard.js",
    "workspace:github:releases": "node scripts/utility/github-release-manager.js",
    "workspace:dashboard:exec": "node scripts/utility/create-executive-dashboard.js",
    "workspace:dashboard:pm": "node scripts/utility/create-pm-dashboard.js",
    "workspace:dashboard:roles": "node scripts/utility/create-role-dashboards.js",
    "workspace:report:weekly": "node scripts/utility/report-generator.js weekly",
    "workspace:report:monthly": "node scripts/utility/report-generator.js monthly",
    "workspace:report:quarterly": "node scripts/utility/report-generator.js quarterly",
    "workspace:template:setup": "node scripts/utility/template-manager.js setup",
    "workspace:template:list": "node scripts/utility/template-manager.js list",
    "workspace:maintain:check": "node scripts/utility/workspace-monitor.js check",
    "workspace:maintain:full": "node scripts/utility/workspace-monitor.js maintain",
    "workspace:maintain:backup": "node scripts/utility/workspace-monitor.js backup",
    "workspace:import:ludus-tasks": "node scripts/utility/import-ludus-tasks.js",
    "workspace:status:update": "node scripts/utility/update-task-status.js"
  },
  "devDependencies": {
    "@changesets/cli": "^2.26.0",
    "@types/node": "^20.0.0",
    "concurrently": "^8.2.0",
    "eslint": "^8.57.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "mongodb-memory-server": "^10.1.4",
    "shadcn": "^3.2.1",
    "supertest": "^7.1.4",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@notionhq/client": "^5.1.0",
    "@notionhq/notion-mcp-server": "^1.9.0",
    "axios": "^1.11.0",
    "dotenv": "^16.6.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  }
}