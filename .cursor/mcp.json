{
  "mcpServers": {
    "github-mcp-lightweight": {
      "command": "npx",
      "args": [
        "@wipiano/github-mcp-lightweight"
      ],
      "env": {
        "GITHUB_TOKEN": ""
      }
    },
    "notion-mcp": {
      "command": "node",
      "args": [
        "node_modules/@notionhq/notion-mcp-server/bin/cli.mjs"
      ],
      "env": {
        "NOTION_TOKEN": ""
      }
    },
    "linear-mcp": {
      "command": "npx",
      "args": [
        "@mseep/linear-mcp"
      ],
      "env": {
        "LINEAR_API_KEY": ""
      }
    },
    "render-mcp-remote": {
      "transport": {
        "type": "http",
        "url": "https://mcp.render.com/mcp"
      }
    }
  }
}