# Test Environment Configuration
# Copy this file to .env.test and fill in your test values

# API Configuration
API_BASE_URL=http://localhost:5000
NODE_ENV=test

# Authentication Tokens (Required for testing)
ADMIN_TOKEN=your_admin_jwt_token_here
USER_TOKEN=your_user_jwt_token_here

# Test User Credentials
TEST_USER_EMAIL=test@example.com
TEST_USER_PASSWORD=TestPassword123!

# Database Configuration
TEST_DATABASE_URL=mongodb://localhost:27017/ludus_test
DATABASE_URL=mongodb://localhost:27017/ludus_test

# Email Testing (Optional)
EMAIL_TESTING_ENABLED=false
TEST_EMAIL=test@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Payment Testing (Optional)
PAYMENT_TESTING_ENABLED=false
MOYASAR_API_KEY=your_moyasar_api_key
MOYASAR_TEST_KEY=your_moyasar_test_key

# Logging
LOG_LEVEL=info
LOG_FILE=test.log

# Test Timeouts
TEST_TIMEOUT=60000
API_TIMEOUT=30000

# Performance Testing
CONCURRENT_USERS=10
RAMP_UP_TIME=30
TEST_DURATION=300
ACCEPTABLE_RESPONSE_TIME=2000
ACCEPTABLE_ERROR_RATE=5
